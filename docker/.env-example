# Compose environment. Copy this file to `.env` (in this directory) to use it:
#   cp docker/.env-example docker/.env
# `.env` is git-ignored — it's local to your machine.

# Which optional compose profiles are active. Set to `development` to include the
# Browserless service (headless Chrome) used by the screenshot tooling — see
# screenshot-engine/README.md. The `app` service always runs regardless; the
# `toolbox` service (profile `tools`) is only started on demand via `run`.
# Leave unset if you don't need screenshots — the app still runs.
COMPOSE_PROFILES=development
